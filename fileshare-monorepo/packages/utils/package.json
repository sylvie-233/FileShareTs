{
  "name": "@fileshare/utils",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FileShare 共享纯函数工具",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@fileshare/types": "workspace:*"
  },
  "devDependencies": {
    "@fileshare/eslint-config": "workspace:*",
    "@fileshare/tsconfig": "workspace:*",
    "eslint": "^9.18.0",
    "rimraf": "^6.0.1",
    "tsdown": "^0.23.7",
    "typescript": "^5.7.3"
  }
}
